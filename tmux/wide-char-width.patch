+/* Display width of a code point, matching the console that hosts the pane. */
+int
+win32_wcwidth32(uint32_t cp)
+{
+	size_t	lo, hi, mid;
+
+	if (cp == 0)
+		return (0);
+	if (cp < 32 || (cp >= 0x7f && cp < 0xa0))
+		return (-1);
+	lo = 0;
+	hi = sizeof win32_wide_ranges / sizeof win32_wide_ranges[0];
+	while (lo < hi) {
+		mid = lo + (hi - lo) / 2;
+		if (cp > win32_wide_ranges[mid].last)
+			lo = mid + 1;
+		else if (cp < win32_wide_ranges[mid].first)
+			hi = mid;
+		else
+			return (2);
+	}
+	return (1);
+}
