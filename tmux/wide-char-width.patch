+/* Decode one UTF-8 sequence to a code point. Returns 0 if it is malformed. */
+int
+win32_utf8_decode(const unsigned char *data, size_t size, uint32_t *cp)
+{
+	static const uint32_t	min[] = { 0, 0, 0x80, 0x800, 0x10000 };
+	uint32_t		c;
+	size_t			i;
+
+	if (size == 1 && data[0] < 0x80)
+		c = data[0];
+	else if (size == 2 && (data[0] & 0xe0) == 0xc0)
+		c = data[0] & 0x1f;
+	else if (size == 3 && (data[0] & 0xf0) == 0xe0)
+		c = data[0] & 0x0f;
+	else if (size == 4 && (data[0] & 0xf8) == 0xf0)
+		c = data[0] & 0x07;
+	else
 		return (0);
-	if (wc < 32 || (wc >= 0x7f && wc < 0xa0))
-		return (-1);
-	/* CJK and fullwidth: rough check. */
-	if ((wc >= 0x1100 && wc <= 0x115f) ||
-	    wc == 0x2329 || wc == 0x232a ||
-	    (wc >= 0x2e80 && wc <= 0xa4cf && wc != 0x303f) ||
-	    (wc >= 0xac00 && wc <= 0xd7a3) ||
-	    (wc >= 0xf900 && wc <= 0xfaff) ||
-	    (wc >= 0xfe10 && wc <= 0xfe19) ||
-	    (wc >= 0xfe30 && wc <= 0xfe6f) ||
-	    (wc >= 0xff01 && wc <= 0xff60) ||
-	    (wc >= 0xffe0 && wc <= 0xffe6))
-		return (2);
+	for (i = 1; i < size; i++) {
+		if ((data[i] & 0xc0) != 0x80)
+			return (0);
+		c = (c << 6) | (data[i] & 0x3f);
+	}
+	if (c < min[size] || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff))
+		return (0);
+	*cp = c;
 	return (1);
 }
 
+/* Encode a code point as UTF-8. Returns the size, or 0 if it is invalid. */
+int
+win32_utf8_encode(uint32_t cp, unsigned char *data)
+{
+	if (cp < 0x80) {
+		data[0] = cp;
+		return (1);
+	}
+	if (cp < 0x800) {
+		data[0] = 0xc0 | (cp >> 6);
+		data[1] = 0x80 | (cp & 0x3f);
+		return (2);
+	}
+	if (cp >= 0xd800 && cp <= 0xdfff)
+		return (0);
+	if (cp < 0x10000) {
+		data[0] = 0xe0 | (cp >> 12);
+		data[1] = 0x80 | ((cp >> 6) & 0x3f);
+		data[2] = 0x80 | (cp & 0x3f);
+		return (3);
+	}
+	if (cp > 0x10ffff)
+		return (0);
+	data[0] = 0xf0 | (cp >> 18);
+	data[1] = 0x80 | ((cp >> 12) & 0x3f);
+	data[2] = 0x80 | ((cp >> 6) & 0x3f);
+	data[3] = 0x80 | (cp & 0x3f);
+	return (4);
+}
